# ============================================================
# Forge 环境变量配置
# 复制此文件为 .env，填入实际值
# ============================================================

# LLM 配置
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# PostgreSQL 配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=forge
PG_USER=postgres
PG_PASSWORD=

# Figma 配置
FIGMA_API_TOKEN=

# 数据目录
DATA_DIR=./data

# 人工介入配置（毫秒）
WEAK_CONFIRMATION_TIMEOUT_MS=30000
HARD_CONFIRMATION_TIMEOUT_MS=0

# 重试配置
LLM_MAX_RETRIES=3
AGENT_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=1000

# 编码阶段配置
MAX_TEST_RETRIES_PER_STORY=5
MAX_CLARIFICATION_ROUNDS=5
MAX_DESIGN_REVIEW_ROUNDS=3
MAX_CODE_REVIEW_ROUNDS=3

# 可观测性配置
LOG_LEVEL=info
LOG_LLM_REQUESTS=true
LOG_DIR=./data/logs

# 向量模型配置（知识库嵌入）
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# 知识库检索配置
KB_SEARCH_TOP_K=10
KB_RERANK_ENABLED=false

# 飞书文档同步配置（v2）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_SPACE_IDS=
